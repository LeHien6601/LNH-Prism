{
  "name": "lnh-prism",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:renderer": "tsc --project tsconfig.json",
    "prepare:showcase": "npm run build:renderer && node scripts/prepare-showcase.mjs",
    "render:primary-button": "npm run build:renderer && node dist/renderer/primary-button-cli.js",
    "render:primary-panel": "npm run build:renderer && node dist/renderer/primary-panel-cli.js",
    "render:primary-progress-bar": "npm run build:renderer && node dist/renderer/primary-progress-bar-cli.js",
    "test:renderer": "npm run build:renderer && node --test tests/renderer/*.test.mjs",
    "validate:contracts": "node tests/contracts/validate-contracts.mjs",
    "validate:showcase": "node scripts/validate-showcase.mjs",
    "validate": "npm run validate:contracts && npm run test:renderer && npm run prepare:showcase && npm run validate:showcase"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2"
  }
}
