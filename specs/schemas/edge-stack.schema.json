{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lnhgames.dev/lnh-prism/schemas/edge-stack/1.0",
  "title": "LNH Prism Edge Stack Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "status", "presets", "bindings", "compatibility"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "$ref": "https://lnhgames.dev/lnh-prism/schemas/component-spec/1.0#/$defs/id" },
    "version": { "$ref": "https://lnhgames.dev/lnh-prism/schemas/component-spec/1.0#/$defs/semver" },
    "status": { "enum": ["draft", "reviewed", "approved", "deprecated"] },
    "presets": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/preset" } },
    "bindings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/binding" } },
    "compatibility": { "type": "object", "additionalProperties": false, "required": ["minimumRendererVersion"], "properties": { "minimumRendererVersion": { "$ref": "https://lnhgames.dev/lnh-prism/schemas/component-spec/1.0#/$defs/semver" }, "migrationNote": { "type": "string", "maxLength": 500 } } }
  },
  "$defs": {
    "layer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "order", "inset", "thickness", "opacity", "color"],
      "properties": {
        "id": { "enum": ["outer-shadow", "structural-silhouette", "body-material", "dark-bevel", "bright-bevel", "inner-shadow", "inner-rim", "accent-highlight"] },
        "order": { "type": "integer", "minimum": 0, "maximum": 7 },
        "inset": { "type": "number", "minimum": 0, "maximum": 24 },
        "thickness": { "type": "number", "exclusiveMinimum": 0, "maximum": 12 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "preset": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "layers"],
      "properties": { "id": { "$ref": "https://lnhgames.dev/lnh-prism/schemas/component-spec/1.0#/$defs/id" }, "version": { "$ref": "https://lnhgames.dev/lnh-prism/schemas/component-spec/1.0#/$defs/semver" }, "layers": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/$defs/layer" } } }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["componentId", "presetId"],
      "properties": { "componentId": { "enum": ["primary-hex-button", "secondary-hex-button", "panel", "tab", "badge", "progress", "icon-container"] }, "presetId": { "$ref": "https://lnhgames.dev/lnh-prism/schemas/component-spec/1.0#/$defs/id" } }
    }
  }
}
