{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lnhgames.dev/lnh-prism/schemas/analysis-review/1.0",
  "title": "LNH Prism Analysis Review Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "analysis", "conceptSha256", "createdAt", "reviews", "mappingGate"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/semver" },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "conceptSha256": { "$ref": "#/$defs/sha256" },
    "createdAt": { "type": "string", "format": "date-time" },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/review" }
    },
    "mappingGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blockingProposalIds"],
      "properties": {
        "status": { "enum": ["blocked", "ready"] },
        "blockingProposalIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "ready" } }, "required": ["status"] },
          "then": { "properties": { "blockingProposalIds": { "type": "array", "maxItems": 0 } } },
          "else": { "properties": { "blockingProposalIds": { "type": "array", "minItems": 1 } } }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mappingGate": {
            "type": "object",
            "properties": { "status": { "const": "ready" } },
            "required": ["status"]
          }
        },
        "required": ["mappingGate"]
      },
      "then": {
        "properties": {
          "reviews": {
            "type": "array",
            "not": {
              "contains": {
                "type": "object",
                "required": ["critical", "disposition"],
                "properties": {
                  "critical": { "const": true },
                  "disposition": { "enum": ["pending", "unresolved"] }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "reviewedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "role": { "enum": ["product", "art", "ui", "technical"] },
        "reviewedAt": { "type": "string", "format": "date-time" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "reviewerId", "at"],
      "properties": {
        "from": { "enum": ["pending", "unresolved"] },
        "to": { "enum": ["accepted", "edited", "rejected", "unresolved"] },
        "reviewerId": { "$ref": "#/$defs/id" },
        "at": { "type": "string", "format": "date-time" }
      },
      "oneOf": [
        {
          "properties": {
            "from": { "const": "pending" },
            "to": { "enum": ["accepted", "edited", "rejected", "unresolved"] }
          }
        },
        {
          "properties": {
            "from": { "const": "unresolved" },
            "to": { "enum": ["accepted", "edited", "rejected"] }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalId", "critical", "disposition", "transitions"],
      "properties": {
        "proposalId": { "$ref": "#/$defs/id" },
        "critical": { "type": "boolean" },
        "disposition": { "enum": ["pending", "accepted", "edited", "rejected", "unresolved"] },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
        "reviewer": { "$ref": "#/$defs/reviewer" },
        "reviewerNote": { "type": "string", "minLength": 1 },
        "editedValue": true
      },
      "allOf": [
        {
          "if": { "properties": { "disposition": { "const": "pending" } }, "required": ["disposition"] },
          "then": { "properties": { "transitions": { "type": "array", "maxItems": 0 } } },
          "else": { "required": ["reviewer"], "properties": { "reviewer": {}, "transitions": { "type": "array", "minItems": 1 } } }
        },
        {
          "if": { "properties": { "disposition": { "enum": ["edited", "rejected", "unresolved"] } }, "required": ["disposition"] },
          "then": { "properties": { "reviewerNote": {} }, "required": ["reviewerNote"] }
        },
        {
          "if": { "properties": { "disposition": { "const": "edited" } }, "required": ["disposition"] },
          "then": { "properties": { "editedValue": {} }, "required": ["editedValue"] }
        }
      ]
    }
  }
}
