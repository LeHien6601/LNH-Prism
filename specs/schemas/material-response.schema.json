{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lnhgames.dev/lnh-prism/schemas/material-response/1.0",
  "title": "LNH Prism Material Response Registry",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "status", "materialPack", "responses", "bindings", "compatibility"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "$ref": "https://lnhgames.dev/lnh-prism/schemas/component-spec/1.0#/$defs/id" },
    "version": { "$ref": "https://lnhgames.dev/lnh-prism/schemas/component-spec/1.0#/$defs/semver" },
    "status": { "enum": ["draft", "reviewed", "approved", "deprecated"] },
    "materialPack": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "$ref": "https://lnhgames.dev/lnh-prism/schemas/component-spec/1.0#/$defs/id" }, "version": { "$ref": "https://lnhgames.dev/lnh-prism/schemas/component-spec/1.0#/$defs/semver" } } },
    "responses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/response" } },
    "bindings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/binding" } },
    "compatibility": { "type": "object", "additionalProperties": false, "required": ["minimumRendererVersion"], "properties": { "minimumRendererVersion": { "$ref": "https://lnhgames.dev/lnh-prism/schemas/component-spec/1.0#/$defs/semver" }, "migrationNote": { "type": "string", "maxLength": 500 } } }
  },
  "$defs": {
    "channel": { "type": "object", "additionalProperties": false, "required": ["color", "opacity"], "properties": { "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 }, "sourceId": { "$ref": "https://lnhgames.dev/lnh-prism/schemas/component-spec/1.0#/$defs/id" } } },
    "response": { "type": "object", "additionalProperties": false, "required": ["id", "version", "base", "edge", "highlight", "glow"], "properties": { "id": { "$ref": "https://lnhgames.dev/lnh-prism/schemas/component-spec/1.0#/$defs/id" }, "version": { "$ref": "https://lnhgames.dev/lnh-prism/schemas/component-spec/1.0#/$defs/semver" }, "base": { "$ref": "#/$defs/channel" }, "edge": { "$ref": "#/$defs/channel" }, "highlight": { "$ref": "#/$defs/channel" }, "glow": { "$ref": "#/$defs/channel" }, "surface": { "$ref": "#/$defs/channel" } } },
    "binding": { "type": "object", "additionalProperties": false, "required": ["componentId", "region", "responseId"], "properties": { "componentId": { "enum": ["primary-hex-button", "secondary-hex-button", "panel", "tab", "badge", "progress", "icon-container"] }, "region": { "enum": ["structural-edge", "content-surface", "focal-surface"] }, "responseId": { "$ref": "https://lnhgames.dev/lnh-prism/schemas/component-spec/1.0#/$defs/id" } } }
  }
}
