{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lnhgames.dev/lnh-prism/schemas/visual-review/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "status", "technicalPreflight", "reviewSurfaces", "visualScore"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string" },
    "status": { "enum": ["draft", "ready-for-human-review", "reviewed"] },
    "technicalPreflight": {
      "type": "object", "additionalProperties": false, "required": ["role", "checks"],
      "properties": {
        "role": { "const": "hard-gate-only" },
        "checks": {
          "type": "array", "minItems": 8,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "status"],
            "properties": { "id": { "type": "string" }, "status": { "enum": ["not-assessed", "pass", "fail"] } }
          }
        }
      }
    },
    "reviewSurfaces": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["distance", "logicalSize", "requiredChecks", "evidence"],
        "properties": {
          "distance": { "enum": ["source", "target-phone", "thumbnail"] },
          "logicalSize": {
            "type": "object", "additionalProperties": false, "required": ["width", "height"],
            "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }
          },
          "requiredChecks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "visualScore": {
      "type": "object", "additionalProperties": false, "required": ["scale", "dimensions"],
      "properties": {
        "scale": { "const": "0-5" },
        "dimensions": {
          "type": "array", "minItems": 9, "maxItems": 9,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "weight"],
            "properties": {
              "id": { "enum": ["silhouette", "material-separation", "edge-hierarchy", "shared-lighting", "focal-strength", "ornament-restraint", "seeded-variation", "composition", "mobile-readability"] },
              "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
              "score": { "type": "integer", "minimum": 0, "maximum": 5 }
            }
          }
        }
      }
    }
  }
}
