{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lnhgames.dev/lnh-prism/schemas/unity-asset-registry/1.0",
  "title": "LNH Prism Unity Asset Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "entries"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "profileId": { "const": "unity-6000-ugui-builtin-android-portrait" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unityAssetId", "metaGuid", "path", "outputSha256"],
        "properties": {
          "unityAssetId": { "type": "string", "pattern": "^lnh-prism:[a-z][a-z0-9-]*$", "maxLength": 160 },
          "metaGuid": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
          "path": { "type": "string", "pattern": "^Assets/LNHPrism/Generated/[a-z][a-z0-9-]*/[a-z][a-z0-9-]*/[a-z][a-z0-9-]*\\.png$" },
          "outputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
