{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lnhgames.dev/lnh-prism/schemas/export-manifest/1.0",
  "title": "LNH Prism Export Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assetId", "generatedAt", "renderer", "sources", "outputs"],
  "properties": {
    "schemaVersion": { "const": "1.0" }, "assetId": { "$ref": "#/$defs/id" }, "generatedAt": { "type": "string", "format": "date-time" },
    "renderer": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "$ref": "#/$defs/semver" } } },
    "sources": { "type": "object", "additionalProperties": false, "required": ["style", "component", "materialPacks"], "properties": { "style": { "$ref": "#/$defs/versionedRef" }, "component": { "$ref": "#/$defs/versionedRef" }, "materialPacks": { "type": "array", "items": { "$ref": "#/$defs/versionedRef" } } } },
    "outputs": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["path", "format", "width", "height", "sha256"], "properties": { "path": { "type": "string", "pattern": "^(?!/)(?!.*\\\\).+" }, "format": { "enum": ["png", "svg"] }, "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/sha256" }, "state": { "enum": ["normal", "pressed", "disabled", "selected", "locked", "highlighted"] }, "unity": { "type": "object", "additionalProperties": false, "properties": { "pixelsPerUnit": { "type": "number", "exclusiveMinimum": 0 }, "pivot": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 } } }, "border": { "type": "object", "additionalProperties": false, "required": ["left", "right", "top", "bottom"], "properties": { "left": { "type": "number", "minimum": 0 }, "right": { "type": "number", "minimum": 0 }, "top": { "type": "number", "minimum": 0 }, "bottom": { "type": "number", "minimum": 0 } } }, "atlasGroup": { "type": "string", "minLength": 1 } } } } } }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" }, "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "versionedRef": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/semver" } } } }
}
