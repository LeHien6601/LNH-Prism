{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lnhgames.dev/lnh-prism/schemas/component-spec/1.0",
  "title": "LNH Prism Component Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "status", "style", "template", "layers", "states", "compatibility"],
  "properties": {
    "schemaVersion": { "const": "1.0" }, "id": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/semver" }, "status": { "enum": ["draft", "reviewed", "approved", "deprecated"] },
    "style": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/semver" } } },
    "template": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/semver" } } },
    "layers": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "enabled"], "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["shadow", "border", "fill", "texture", "highlight", "decal", "content", "extrusion", "bevel"] }, "enabled": { "type": "boolean" }, "parameters": { "type": "object" } } } },
    "states": { "type": "object", "minProperties": 1, "propertyNames": { "enum": ["normal", "pressed", "disabled", "selected", "locked", "highlighted"] }, "additionalProperties": { "type": "object", "additionalProperties": false, "properties": { "layerOverrides": { "type": "object" }, "contentOffset": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } } } } },
    "sizing": { "type": "object", "additionalProperties": false, "properties": { "mode": { "enum": ["fixed", "stretch", "nine-slice"] }, "minimum": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } } } } },
    "geometry": { "$ref": "#/$defs/geometry" },
    "compatibility": { "type": "object", "additionalProperties": false, "required": ["minimumRendererVersion"], "properties": { "minimumRendererVersion": { "$ref": "#/$defs/semver" }, "migrationNote": { "type": "string", "maxLength": 500 } } },
    "materialBindings": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["slot", "materialId"], "properties": { "slot": { "enum": ["surface-grain", "surface-pattern", "accent-decal", "edge-light-profile", "bevel-profile", "edge-energy-accent", "ornament-decal"] }, "materialId": { "$ref": "#/$defs/id" }, "overrides": { "$ref": "#/$defs/materialOverrides" } } } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
    "box": { "type": "object", "additionalProperties": false, "required": ["left", "right", "top", "bottom"], "properties": { "left": { "type": "number", "minimum": 0 }, "right": { "type": "number", "minimum": 0 }, "top": { "type": "number", "minimum": 0 }, "bottom": { "type": "number", "minimum": 0 } } },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape"],
      "properties": {
        "shape": { "enum": ["rounded-rect", "wide-hexagon", "chamfered-rect", "faceted-octagon"] },
        "cornerRadius": { "type": "number", "minimum": 0, "maximum": 32 },
        "endCapDepth": { "type": "number", "minimum": 16, "maximum": 56 },
        "chamfer": { "type": "number", "minimum": 0, "maximum": 56 },
        "contentSafeArea": { "$ref": "#/$defs/box" },
        "approvedLayerOrder": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["content", "ornament-decal", "edge-energy-accent", "top-bevel-highlight", "side-bevel-shade", "surface-pattern", "surface-grain", "inner-plate-fill", "outer-frame", "connected-depth", "outer-shadow"] } }
      },
      "allOf": [
        {
          "if": { "properties": { "shape": { "const": "wide-hexagon" } }, "required": ["shape"] },
          "then": { "required": ["cornerRadius", "endCapDepth", "contentSafeArea"], "properties": { "cornerRadius": { "type": "number", "maximum": 4 }, "endCapDepth": true, "contentSafeArea": true } }
        }
      ]
    },
    "materialOverrides": { "type": "object", "additionalProperties": false, "properties": { "grainOpacity": { "type": "number", "minimum": 0, "maximum": 0.2 }, "patternOpacity": { "type": "number", "minimum": 0, "maximum": 0.18 }, "patternScale": { "type": "number", "minimum": 16, "maximum": 64 }, "edgeLightOpacity": { "type": "number", "minimum": 0, "maximum": 0.65 }, "bevelDepth": { "type": "number", "minimum": 0, "maximum": 4 }, "decalOpacity": { "type": "number", "minimum": 0, "maximum": 0.3 } } }
  }
}
